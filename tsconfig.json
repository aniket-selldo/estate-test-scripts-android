{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "mocha", "@wdio/globals/types", "@wdio/mocha-framework", "@wdio/appium-service", "expect-webdriverio"]
  },
  "include": ["automation.config.ts", "wdio.conf.ts", "src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
