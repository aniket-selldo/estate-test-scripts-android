{
  "name": "crm-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Sell.do CRM Flutter app - Appium (WebdriverIO) automation suite",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "doctor": "tsx scripts/doctor.ts",
    "inspect": "tsx scripts/inspect-screen.ts",
    "refs:sync": "tsx scripts/sync-refs.ts",
    "test": "wdio run ./wdio.conf.ts",
    "test:smoke": "wdio run ./wdio.conf.ts --mochaOpts.grep @smoke",
    "test:spec": "wdio run ./wdio.conf.ts --spec",
    "test:failed": "tsx scripts/rerun-failed.ts",
    "allure:generate": "allure generate ./reports/allure-results -o ./reports/allure-report --clean",
    "allure:open": "allure open ./reports/allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@wdio/allure-reporter": "^10.2.0",
    "@wdio/appium-service": "^10.2.0",
    "@wdio/cli": "^10.2.0",
    "@wdio/globals": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "@wdio/types": "^10.2.0",
    "allure-commandline": "^2.46.1",
    "expect-webdriverio": "^8.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "webdriverio": "^10.2.0"
  }
}
